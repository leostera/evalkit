{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "evalkit-www",
  "compatibility_date": "2026-09-24",
  "workers_dev": false,
  "routes": [{ "pattern": "evalkit.leostera.dev", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  "observability": {
    "enabled": true,
    "traces": { "enabled": true },
  },
}
