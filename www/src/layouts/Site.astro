---
import '../styles/site.css';
import Icon from '../components/Icon.astro';
interface Props {
  title: string;
  description: string;
  active?: 'home' | 'docs' | 'manual';
}
const { title, description, active } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f8fa" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="preload"
      href="/fonts/public-sans-latin-variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="alternate"
      type="text/plain"
      title="LLM guide"
      href="/llms.txt"
    />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <div class="site-shell">
      <header class="site-header wrap">
        <a
          class="wordmark"
          href="/"
          aria-label="EvalKit home"
          aria-current={active === 'home' ? 'page' : undefined}
        >
          <span class="mark" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
            <span></span>
          </span>
          <span>evalkit</span>
        </a>
        <nav aria-label="Main navigation">
          <a
            href="/docs/"
            aria-current={active === 'docs' ? 'page' : undefined}
          >
            Docs
          </a>
          <a href="https://github.com/leostera/evalkit/tree/main/examples">
            Examples
          </a>
          <a class="nav-github" href="https://github.com/leostera/evalkit">
            <Icon name="github" /> GitHub
          </a>
        </nav>
      </header>
      <main id="main">
        <slot />
      </main>
      <footer class="site-footer wrap">
        <div>
          <a class="footer-brand" href="/">
            evalkit
          </a>
          <p>
            Built by <a href="https://github.com/leostera">@leostera</a> at{' '}
            <a href="https://www.cloudflare.com/">Cloudflare</a>.
          </p>
        </div>
        <nav class="footer-links" aria-label="Project links">
          <a href="/docs/manual/">Manual</a>
          <a href="https://github.com/leostera/evalkit/issues">
            Issues & ideas
          </a>
          <a href="https://github.com/leostera/evalkit/blob/main/HACKING.md">
            Contribute
          </a>
          <a href="https://github.com/leostera/evalkit/blob/main/LICENSE">
            MIT license
          </a>
        </nav>
      </footer>
    </div>
  </body>
</html>
