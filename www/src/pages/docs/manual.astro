---
import Site from '../../layouts/Site.astro';
import { manualHtml, sections } from '../../lib/manual';
---

<Site title="Manual — Evalkit" description="The complete Evalkit manual: local setup, agents, fixtures, evals, scoring, matrices, and results." active="manual">
  <div class="docs-header wrap"><span class="section-kicker">EVALKIT / REFERENCE</span><h1>The manual<span class="text-accent">.</span></h1><p>The complete guide, maintained as one Markdown source in this repository. Everything here describes the current local implementation.</p></div>
  <div class="docs-layout wrap">
    <aside class="docs-sidebar" aria-label="Manual sections">
      <span>IN THIS MANUAL</span>
      {sections.map(({ id, title }, index) => <a href={`#${id}`}>{String(index + 1).padStart(2, '0')} / {title}</a>)}
      <div class="sidebar-separator"></div>
      <a href="/docs/">Quick start ↗</a>
      <a href="https://github.com/leostera/evalkit/blob/main/www/src/content/manual.md">Edit on GitHub ↗</a>
    </aside>
    <article class="manual-content" set:html={manualHtml} />
  </div>
</Site>
