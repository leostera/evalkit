{
  "name": "@leostera/evalkit",
  "version": "0.4.0",
  "description": "Author and run agent evals as code",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leostera/evalkit.git"
  },
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "packages/*",
    "examples/*",
    "sites/*"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./runner": {
      "types": "./dist/runner.d.mts",
      "import": "./dist/runner.mjs"
    },
    "./share": {
      "types": "./dist/share.d.mts",
      "import": "./dist/share.mjs"
    },
    "./share/worker": {
      "types": "./dist/share-worker.d.mts",
      "import": "./dist/share-worker.mjs"
    }
  },
  "bin": {
    "evalkit": "dist/cli.mjs"
  },
  "dependencies": {
    "effect": "^3.22.2",
    "hono": "^4.11.6"
  },
  "scripts": {
    "build": "bun run --filter './packages/*' build && bun scripts/sync-package.ts",
    "check": "bun run --filter './packages/*' check && bun run --filter './examples/*' check",
    "lint": "oxlint --react-plugin --jsx-a11y-plugin --deny-warnings packages examples scripts sites/evalkit.leostera.dev/src",
    "test": "bun test",
    "pack:check": "bun packages/evalkit/scripts/pack-check.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rm -rf packages/*/dist dist"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "oxlint": "1.87.0",
    "prettier": "latest",
    "typescript": "latest"
  }
}
