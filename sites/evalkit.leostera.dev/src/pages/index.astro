---
import { Code } from 'astro:components';
import Site from '../layouts/Site.astro';
import Icon from '../components/Icon.astro';
import {
  ciCommands,
  codeTheme,
  harnessExample,
  sandboxExample,
  scaffoldCommand,
  setupCommands,
} from '../content/snippets';

const examples = 'https://github.com/leostera/evalkit/tree/main/examples';
---

<Site
  title="EvalKit — Test AI agents like you test code"
  description="Write agent evals in TypeScript. Run Pi, Codex, opencode, Claude Code or your own agent through them, score every run with checks and LLM judges, and see why each one passed or failed. Free and open source."
  active="home"
>
  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero-heading">
      <h1 id="hero-title">Test AI agents like you test code.</h1>
      <div class="hero-copy">
        <p>
          Write scenarios in TypeScript. Run your agent through them. See every
          message, tool call and verdict behind each score.
        </p>
        <p class="hero-detail">
          Pi, Codex, opencode, Claude Code or your own agent. On your machine,
          in containers or on machines you provide. Every run kept on disk.
        </p>
      </div>
    </div>
    <div class="hero-tools">
      <div class="hero-actions">
        <a class="button button-primary" href="/docs/">
          Run your first eval <Icon name="arrow" />
        </a>
        <a
          class="button button-quiet"
          href="https://github.com/leostera/evalkit"
        >
          <Icon name="github" /> View source
        </a>
      </div>
      <div class="install-command">
        <code>{scaffoldCommand}</code>
        <button
          class="copy-command"
          data-copy={scaffoldCommand}
          aria-label="Copy project creation command"
          hidden
        >
          <Icon name="copy" />
        </button>
      </div>
    </div>
    <div class="hero-notes">
      <a href="https://github.com/leostera/evalkit/blob/main/LICENSE">
        MIT licensed
      </a>
      <span>No EvalKit account</span>
      <span>The starter needs no model key</span>
      <span>Bun + TypeScript</span>
    </div>
    <p class="copy-status" role="status" aria-live="polite"></p>

    <figure class="shot shot-hero">
      <a class="shot-link" href="/images/dashboard-run.webp" aria-label="Open the full-size screenshot">
<img
        src="/images/dashboard-run.webp"
        alt="A failed run in the EvalKit dashboard: the run's details on the left, the conversation in the middle, and on the right why it failed: the correctness judge answered C because the reply recommends Purge Everything, with the prompt the judge saw, a failed docs-link check and a passed tone judge."
        width="2880"
        height="1800"
        fetchpriority="high"
        decoding="async"
      />
</a>
      <figcaption>
        A failed run, opened in <code>evalkit dev</code>: the reply, why each
        check and judge decided, and the prompt the judge saw.
        <a href={`${examples}/judges`}>
          examples/judges <Icon name="external" />
        </a>
      </figcaption>
    </figure>
  </section>

  <section class="feature wrap" aria-labelledby="agents-title">
    <div class="feature-text">
      <h2 id="agents-title">Run the agents you already use.</h2>
      <p>
        Coding agents come with harnesses: each run starts its own session in a
        fresh workspace, with a private config, and the agent's own session
        file becomes the run's transcript, with every tool call and token.
      </p>
      <ul class="feature-points">
        <li>
          <code>piAgent()</code>, <code>codexAgent()</code>,
          <code>opencodeAgent()</code>, <code>claudeCodeAgent()</code>
        </li>
        <li><code>defineAgent()</code> for your own service or SDK</li>
        <li>Pick the model per matrix cell; EvalKit never calls a provider</li>
      </ul>
      <a class="text-link" href="/docs/manual/agents/">
        Agents under test <Icon name="arrow" />
      </a>
    </div>
    <div class="code-example">
      <div class="code-header">
        <span>scenarios/fix-failing-test.eval.ts</span>
        <span>TypeScript</span>
      </div>
      <Code code={harnessExample} lang="ts" theme={codeTheme} />
    </div>
  </section>

  <section class="feature feature-flip wrap" aria-labelledby="judges-title">
    <div class="feature-text">
      <h2 id="judges-title">Score it like a reviewer would.</h2>
      <p>
        Use checks for what code can decide: the tests pass, the file exists,
        the right tool was called. Use judges for the rest: a rubric, answered
        with a choice or weighted criteria. Every verdict says why, with the
        evidence it looked at.
      </p>
      <ul class="feature-points">
        <li>Criteria with their own weight, score and evidence</li>
        <li>Judges run by an agent you choose, recorded in full</li>
        <li>Pass marks per scorer, partial credit for partial runs</li>
      </ul>
      <a class="text-link" href="/docs/manual/scoring-and-evals/">
        Scoring and judges <Icon name="arrow" />
      </a>
    </div>
    <figure class="shot">
      <a class="shot-link" href="/images/dashboard-evidence.webp" aria-label="Open the full-size screenshot">
<img
        src="/images/dashboard-evidence.webp"
        alt="A run's trajectory and verdicts: a notes service check scored 0.33 as the weighted mean of three criteria, saves passed, history and one commit per save failed, each with its evidence shown as a tree."
        width="1840"
        height="1600"
        loading="lazy"
        decoding="async"
      />
</a>
      <figcaption>
        One check, three criteria, the evidence behind each.
      </figcaption>
    </figure>
  </section>

  <section class="feature wrap" aria-labelledby="checkpoints-title">
    <div class="feature-text">
      <h2 id="checkpoints-title">Check the conversation as it happens.</h2>
      <p>
        A scenario is a transcript: user messages, and checkpoints between
        them. Check the first reply before sending the second, assert a tool
        call, and stop early with <code>failfast</code> when there is no point
        going on.
      </p>
      <ul class="feature-points">
        <li>Scripted turns, or files and values from datasets</li>
        <li>Expected answers kept out of the agent's reach</li>
        <li>Limits on steps, tokens and time end a run as limited</li>
      </ul>
      <a class="text-link" href="/docs/manual/datasets/">
        Scenarios and datasets <Icon name="arrow" />
      </a>
    </div>
    <figure class="shot">
      <a class="shot-link" href="/images/dashboard-checkpoints.webp" aria-label="Open the full-size screenshot">
<img
        src="/images/dashboard-checkpoints.webp"
        alt="A trajectory with checkpoints: first reply passed, write_file passed, first file version failed, and the remaining steps skipped after the failed checkpoint."
        width="1840"
        height="1000"
        loading="lazy"
        decoding="async"
      />
</a>
      <figcaption>
        A failed checkpoint stops the run; the steps after it are skipped.
      </figcaption>
    </figure>
  </section>

  <section class="wide-feature" aria-labelledby="sweep-title">
    <div class="wrap">
      <div class="feature-text wide-text">
        <h2 id="sweep-title">Change one thing. See what moved.</h2>
        <p>
          Sweep models, prompts or tools with a matrix, repeat each cell, and
          read the scoreboard: every scenario and setting with its latest run,
          pass rate, time and tokens. In CI, write JUnit, share the results and
          fail the merge request on a regression against <code>main</code>.
        </p>
      </div>
      <figure class="shot">
        <a class="shot-link" href="/images/dashboard-scoreboard.webp" aria-label="Open the full-size screenshot">
<img
          src="/images/dashboard-scoreboard.webp"
          alt="The scoreboard for a model sweep: scenarios grouped into chat and apps suites, each with its judge model and agent model, latest status, score, mean score, last runs, pass rate, mean agent time and mean tokens."
          width="2880"
          height="1340"
          loading="lazy"
          decoding="async"
        />
</a>
        <figcaption>
          Three agent models, one judge model, two suites.
          <a href={`${examples}/judges`}>
            examples/judges <Icon name="external" />
          </a>
        </figcaption>
      </figure>
      <div class="setup-code ci-code">
        <div class="code-header">
          <span>CI</span>
          <span>Report, share, gate</span>
        </div>
        <Code code={ciCommands} lang="sh" theme={codeTheme} />
      </div>
    </div>
  </section>

  <section class="feature feature-flip wrap" aria-labelledby="sandbox-title">
    <div class="feature-text">
      <h2 id="sandbox-title">Give every run its own machine.</h2>
      <p>
        Runs happen in a sandbox: this machine, a container per run, or a
        remote machine you provide, such as a VM or a cloud sandbox. The agent
        does what it likes inside; the checks see what it left. Services the
        runs need start once, as fixtures.
      </p>
      <ul class="feature-points">
        <li>A sandbox per scenario, or swept as a matrix axis</li>
        <li>Containers from a Dockerfile, with only the network you allow</li>
        <li>Everything a run started is stopped when it ends</li>
      </ul>
      <a class="text-link" href="/docs/manual/agents/#sandboxes">
        Sandboxes and fixtures <Icon name="arrow" />
      </a>
    </div>
    <div class="code-example">
      <div class="code-header">
        <span>evalkit.config.ts</span>
        <span>TypeScript</span>
      </div>
      <Code code={sandboxExample} lang="ts" theme={codeTheme} />
    </div>
  </section>

  <section class="feature wrap" aria-labelledby="results-title">
    <div class="feature-text">
      <h2 id="results-title">Keep every run. Share the ones that matter.</h2>
      <p>
        Each run is a directory: its transcript in the open ATXF format, its
        scores, its logs and the files the agent left. Share a commit's results
        with a server your team runs, or build a static snapshot for any host.
      </p>
      <ul class="feature-points">
        <li><code>evalkit share</code> and <code>evalkit compare</code></li>
        <li><code>evalkit build</code> for a read-only dashboard</li>
        <li><code>evalkit upgrade</code> moves old results forward</li>
      </ul>
      <a class="text-link" href="/docs/manual/results/">
        Results and reports <Icon name="arrow" />
      </a>
    </div>
    <figure class="shot">
      <a class="shot-link" href="/images/dashboard-workspace.webp" aria-label="Open the full-size screenshot">
<img
        src="/images/dashboard-workspace.webp"
        alt="A run's workspace files: notes.json, the file the agent wrote, shown with syntax highlighting."
        width="1840"
        height="1000"
        loading="lazy"
        decoding="async"
      />
</a>
      <figcaption>What the agent left in its workspace.</figcaption>
    </figure>
  </section>

  <section class="section wrap ownership" aria-labelledby="ownership-title">
    <div>
      <h2 id="ownership-title">
        Your evals.
        <br />
        Your infrastructure.
        <br />
        <span>No platform required.</span>
      </h2>
      <p>
        EvalKit is free, open-source software. Run it locally, inspect the
        implementation, and make it yours.
      </p>
      <a
        class="text-link"
        href="https://github.com/leostera/evalkit/blob/main/LICENSE"
      >
        Read the MIT license <Icon name="arrow" />
      </a>
    </div>
    <dl class="ownership-list">
      <div>
        <dt>Definitions in Git</dt>
        <dd>Review and version evals alongside the agent they test.</dd>
      </div>
      <div>
        <dt>Results on disk</dt>
        <dd>
          JSON scores, ATXF transcripts and workspace snapshots. No hosted
          account required.
        </dd>
      </div>
      <div>
        <dt>Bring your own agent and model</dt>
        <dd>
          EvalKit never calls a model provider. Your agent does, with your keys.
        </dd>
      </div>
      <div>
        <dt>Free software. No hidden platform tier.</dt>
        <dd>
          MIT licensed. Any model-provider or infrastructure costs remain yours.
        </dd>
      </div>
    </dl>
  </section>

  <section class="getting-started" aria-labelledby="start-title">
    <div class="wrap start-layout">
      <div>
        <h2 id="start-title">
          Start with a run.
          <br />
          Not a signup.
        </h2>
        <p>
          The generated greeting eval runs without a model key. Get a result
          first. Bring your own agent next.
        </p>
        <a class="button button-primary" href="/docs/">
          Get started <Icon name="arrow" />
        </a>
        <p class="prerequisite">
          Requires <a href="https://bun.sh/">Bun 1.4.2</a> · Run commands in
          your new project.
        </p>
      </div>
      <div class="setup-code">
        <div class="code-header">
          <span>Terminal</span>
          <span>Local setup</span>
        </div>
        <Code code={setupCommands} lang="sh" theme={codeTheme} />
      </div>
    </div>
  </section>
</Site>

<script>
  const status = document.querySelector<HTMLElement>('.copy-status');
  document
    .querySelectorAll<HTMLButtonElement>('[data-copy]')
    .forEach((button) => {
      button.hidden = false;
      button.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(button.dataset.copy ?? '');
          if (status)
            status.textContent =
              'Command copied. Paste it into your terminal to create a project.';
        } catch {
          if (status)
            status.textContent =
              'Could not copy. Select the command above and copy it manually.';
        }
      });
    });
</script>
